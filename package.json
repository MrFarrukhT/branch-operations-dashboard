{
  "name": "branch-operations-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive operations dashboard for branch KPIs: revenue, client retention, active clients and support resolution by region, quarter and service tier.",
  "author": "Avada (https://avada.uz)",
  "type": "module",
  "scripts": {
    "data": "tsx scripts/build-data.ts",
    "dev": "pnpm data && vite",
    "build": "pnpm data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4",
    "tailwind-merge": "3.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vite": "6.4.6"
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
